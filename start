#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PORT="${STAR67_PORT:-5199}"

case "${1:-}" in
  "") ;;
  -h|--help)
    echo "Start Star67 locally. Set STAR67_PORT to change the port or STAR67_NO_OPEN=1 to skip opening a browser."
    exit 0
    ;;
  *)
    echo "Usage: ./start [--help]" >&2
    exit 2
    ;;
esac

if ! command -v node >/dev/null 2>&1; then
  echo "Star67 needs Node.js 20 or newer. Install Node, then run ./start again." >&2
  exit 1
fi

NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$NODE_MAJOR" -lt 20 ]; then
  echo "Star67 needs Node.js 20 or newer (found $(node --version))." >&2
  exit 1
fi

cd "$ROOT"

if [ ! -x node_modules/.bin/vite ]; then
  echo "First run: installing the local, open-source dependencies…"
  npm ci --no-audit --no-fund
fi

needs_build=0
if [ ! -f dist/index.html ]; then
  needs_build=1
elif [ ! -f public/data/manifest.json ]; then
  needs_build=1
elif find src public scripts -type f -newer dist/index.html -print -quit | grep -q .; then
  needs_build=1
elif find index.html package.json package-lock.json vite.config.* tsconfig*.json -type f -newer dist/index.html -print -quit 2>/dev/null | grep -q .; then
  needs_build=1
fi

if [ "$needs_build" -eq 1 ]; then
  echo "Building the local practice warehouse (first run can take a minute)…"
  npm run build
fi

URL="http://127.0.0.1:${PORT}/"
LOG_FILE="$(mktemp -t star67-preview.XXXXXX)"
PREVIEW_PID=""
cleanup() {
  local status=$?
  if [ -n "$PREVIEW_PID" ] && kill -0 "$PREVIEW_PID" >/dev/null 2>&1; then
    kill "$PREVIEW_PID" >/dev/null 2>&1 || true
    wait "$PREVIEW_PID" >/dev/null 2>&1 || true
  fi
  rm -f "$LOG_FILE"
  trap - EXIT
  exit "$status"
}
trap cleanup EXIT INT TERM

# Bind first and refuse a silent port fallback. The old order opened the URL
# before Vite was listening and printed the requested port even when Vite had
# moved to another one, which made a healthy local install look broken.
node_modules/.bin/vite preview --host 127.0.0.1 --port "$PORT" --strictPort >"$LOG_FILE" 2>&1 &
PREVIEW_PID=$!
ready=0
for _ in $(seq 1 100); do
  if grep -q "127.0.0.1:${PORT}" "$LOG_FILE" \
      && curl -fsS "$URL" | grep -q '<div id="root"></div>'; then
    ready=1
    break
  fi
  if grep -qi "already in use" "$LOG_FILE"; then
    cat "$LOG_FILE" >&2
    exit 1
  fi
  if ! kill -0 "$PREVIEW_PID" >/dev/null 2>&1; then
    cat "$LOG_FILE" >&2
    exit 1
  fi
  sleep 0.1
done
if [ "$ready" -ne 1 ]; then
  echo "Star67 did not become ready at ${URL}." >&2
  cat "$LOG_FILE" >&2
  exit 1
fi

echo "Star67 is ready at ${URL}"
echo "Keep this Terminal window open. Press Ctrl-C to stop."

if [ "${STAR67_NO_OPEN:-0}" != "1" ]; then
  if command -v open >/dev/null 2>&1; then
    open "$URL" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" >/dev/null 2>&1 || true
  fi
fi

wait "$PREVIEW_PID"
